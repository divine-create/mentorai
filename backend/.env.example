# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentorai

# Redis — matches docker-compose.yml
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI model providers ──────────────────────────────────────────────────────
# At least one is required. The model selector only offers providers whose key
# is set here; others appear greyed out. Default model is Claude Sonnet.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key

# DeepSeek — https://platform.deepseek.com (OpenAI-compatible API)
DEEPSEEK_API_KEY=your-deepseek-key

# Google Gemini — https://aistudio.google.com/app/apikey (OpenAI-compatible API)
GEMINI_API_KEY=your-gemini-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# PostHog
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# Admin — comma-separated emails allowed to access /api/admin (book uploads).
ADMIN_EMAILS=admin@example.com
