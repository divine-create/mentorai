{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/admin", "destination": { "service": "backend" } },
    { "source": "/api/feedback/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/feedback", "destination": { "service": "backend" } },
    { "source": "/api/models/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/models", "destination": { "service": "backend" } },
    { "source": "/api/notifications/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/notifications", "destination": { "service": "backend" } },
    { "source": "/api/profile/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/profile", "destination": { "service": "backend" } },
    { "source": "/api/projects/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/projects", "destination": { "service": "backend" } },
    { "source": "/api/review/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/review", "destination": { "service": "backend" } },
    { "source": "/api/voice/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/voice", "destination": { "service": "backend" } },
    { "source": "/api/tutor/code-feedback", "destination": { "service": "backend" } },
    { "source": "/api/tutor/hint", "destination": { "service": "backend" } },
    { "source": "/api/tutor/solution", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
